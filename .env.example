# =============================================================================
# WSS Map Processing Platform - environment configuration
# Copy to `.env` and adjust. Docker Compose reads this file automatically.
# =============================================================================

# --- General ---
APP_ENV=development
APP_NAME="WSS Map Processing Platform"
LOG_LEVEL=INFO
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=wss
POSTGRES_PASSWORD=wss
POSTGRES_DB=wss
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# SQLAlchemy DSN (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://wss:wss@postgres:5432/wss

# --- Redis (queue + worker coordination) ---
REDIS_URL=redis://redis:6379/0

# --- Garage / S3-compatible object storage ---
# Internal endpoint used by the API/workers for server-side object operations.
S3_ENDPOINT=http://garage:3900
# Public endpoint the BROWSER uses for direct uploads. Presigned URLs are
# signed against this host, so it must be reachable from the browser.
# Locally this is the Caddy CORS proxy (garage-cors) published on port 3900.
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=wss
# Garage serves the S3 API in path-style addressing
S3_FORCE_PATH_STYLE=true
# Presigned URL lifetime (seconds)
S3_PRESIGN_EXPIRE=900

# Credentials. For local Docker leave these EMPTY: `garage-init` creates an
# access key and writes it to a shared volume, and the services read it via the
# *_FILE paths below. For Coolify/production, set S3_ACCESS_KEY / S3_SECRET_KEY
# from your secret manager instead.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ACCESS_KEY_FILE=/run/garage/access_key
S3_SECRET_KEY_FILE=/run/garage/secret_key

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Bootstrap admin (seeded on first API start) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Administrator

# --- Upload validation ---
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/tiff

# --- OCR engine ---
# tesseract | paddleocr | stub
OCR_ENGINE=tesseract
OCR_LANG=eng
# Tesseract page segmentation mode (7 = single text line)
OCR_PSM=7
# Restrict recognition to digits + common OCR-confusable letters
OCR_WHITELIST=0123456789OolISsBZG

# --- IDSUBSLS pattern ---
ID_PATTERN=^\d{16}$
ID_LENGTH=16

# --- Quality / decision thresholds (tune after benchmark) ---
PAPER_MIN_CONFIDENCE=0.60
OCR_AUTO_ACCEPT_CONFIDENCE=0.90
OCR_REVIEW_CONFIDENCE=0.55
FUZZY_AUTO_ACCEPT_RATIO=0.93
FUZZY_REVIEW_RATIO=0.72
QUALITY_MIN_SCORE=0.50

# --- Adaptive upscaling ---
UPSCALE_MIN_SHORT_SIDE=1600
UPSCALE_MAX_FACTOR=2.0

# --- Worker ---
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_VISIBILITY_TIMEOUT=1800
# Absolute path for temporary intermediate files inside the worker container
WORKER_TMP_DIR=/tmp/wss

# --- Frontend ---
# Browser-visible API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side API base URL (inside docker network)
API_INTERNAL_URL=http://api:8000
